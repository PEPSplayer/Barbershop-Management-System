<Window x:Class="HairSalonIS.Views.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Состав заказа"
        Height="650"
        Width="950"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="OrderInfoTextBlock"
                   Text="Состав заказа"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#2D3748"
                   Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Услуги заказа -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#CBD5E0"
                    BorderThickness="1"
                    Padding="15">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Услуги в заказе"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#2D3748"
                               Margin="0,0,0,15"/>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,0,0,15">

                        <ComboBox x:Name="ServiceComboBox"
                                  Width="260"
                                  Height="35"
                                  FontSize="14"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,10,0"/>

                        <Button Content="Добавить"
                                Width="100"
                                Height="35"
                                Click="AddServiceButton_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="ServicesDataGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              FontSize="14"/>

                    <Button Grid.Row="3"
                            Content="Удалить услугу"
                            Width="140"
                            Height="35"
                            HorizontalAlignment="Right"
                            Margin="0,15,0,0"
                            Click="DeleteServiceButton_Click"/>
                </Grid>
            </Border>

            <!-- Материалы заказа -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#CBD5E0"
                    BorderThickness="1"
                    Padding="15">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Материалы в заказе"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#2D3748"
                               Margin="0,0,0,15"/>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,0,0,15">

                        <ComboBox x:Name="MaterialComboBox"
                                  Width="260"
                                  Height="35"
                                  FontSize="14"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,10,0"/>

                        <Button Content="Добавить"
                                Width="100"
                                Height="35"
                                Click="AddMaterialButton_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="MaterialsDataGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              FontSize="14"/>

                    <Button Grid.Row="3"
                            Content="Удалить материал"
                            Width="150"
                            Height="35"
                            HorizontalAlignment="Right"
                            Margin="0,15,0,0"
                            Click="DeleteMaterialButton_Click"/>
                </Grid>
            </Border>
        </Grid>

        <Button Grid.Row="2"
                Content="Закрыть"
                Width="120"
                Height="35"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"
                Click="CloseButton_Click"/>
    </Grid>
</Window>