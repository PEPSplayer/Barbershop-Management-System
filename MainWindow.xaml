<Window x:Class="HairSalonIS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информационная система парикмахерской"
        Height="720"
        Width="1200"
        MinHeight="650"
        MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левое меню -->
        <Border Grid.Column="0" Background="#0F172A">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="0,0,0,18">

                    <TextBlock Text="Парикмахерская"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="22,28,20,4"/>

                    <TextBlock Text="Информационная система"
                               Foreground="#CBD5E1"
                               FontSize="13"
                               Margin="22,0,20,25"/>

                    <Button Content="Работа с клиентами"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="ClientsButton_Click"/>

                    <Button Content="Управление мастерами"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="MastersButton_Click"/>

                    <Button Content="Каталог услуг"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="ServicesButton_Click"/>

                    <Button Content="Оформление заказов"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="OrdersButton_Click"/>

                    <Button Content="Расписание записей"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="ScheduleButton_Click"/>

                    <Button Content="Учёт материалов"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="MaterialsButton_Click"/>

                    <Button Content="Поставщики"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="SuppliersButton_Click"/>

                    <Button Content="Учёт поставок"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="ShipmentsButton_Click"/>

                    <Button Content="Отчёты"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="ReportsButton_Click"/>

                    <Button Content="Архив заказов"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="OrderArchiveButton_Click"/>

                    <Button Content="Журнал действий"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="ActionLogButton_Click"/>

                    <Button Content="Выход"
                            Style="{StaticResource MenuButtonStyle}"
                            Margin="15,20,15,5"
                            Click="LogoutButton_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Основная область -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="PageTitleTextBlock"
                       Text="Главная"
                       Style="{StaticResource PageTitleStyle}"/>

            <!-- Поиск -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="15"
                    Margin="0,0,0,14">

                <StackPanel Orientation="Horizontal">

                    <TextBox x:Name="SearchTextBox"
                             Width="330"
                             Height="36"
                             FontSize="14"
                             Margin="0,0,10,0"/>

                    <Button Content="Поиск"
                            Width="105"
                            Height="36"
                            Click="SearchButton_Click"/>

                    <Button Content="Обновить"
                            Width="105"
                            Height="36"
                            Margin="10,0,0,0"
                            Click="RefreshButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Действия -->
            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="15"
                    Margin="0,0,0,14">

                <StackPanel Orientation="Horizontal">

                    <Button Content="Добавить"
                            Width="110"
                            Height="36"
                            Margin="0,0,10,0"
                            Click="AddButton_Click"/>

                    <Button Content="Редактировать"
                            Width="135"
                            Height="36"
                            Margin="0,0,10,0"
                            Click="EditButton_Click"/>

                    <Button Content="Удалить"
                            Width="110"
                            Height="36"
                            Margin="0,0,10,0"
                            Click="DeleteButton_Click"/>

                    <Button Content="Состав заказа"
                            Width="145"
                            Height="36"
                            Click="OrderDetailsButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Таблица -->
            <DataGrid x:Name="MainDataGrid"
                      Grid.Row="3"
                      AutoGenerateColumns="True"
                      AutoGeneratingColumn="MainDataGrid_AutoGeneratingColumn"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      IsReadOnly="True"
                      FontSize="14"
                      Background="White"/>
        </Grid>
    </Grid>
</Window>