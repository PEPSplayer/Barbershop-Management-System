<Window x:Class="HairSalonIS.Views.ActionLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Журнал действий пользователей"
        Height="650"
        Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Журнал действий пользователей"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#2D3748"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#CBD5E0"
                BorderThickness="1"
                Padding="15"
                Margin="0,0,0,15">

            <StackPanel Orientation="Horizontal">

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Поиск"
                               FontSize="14"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="SearchTextBox"
                             Width="300"
                             Height="35"
                             FontSize="14"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <Button Content="Найти"
                        Width="110"
                        Height="35"
                        Margin="0,20,10,0"
                        Click="SearchButton_Click"/>

                <Button Content="Обновить"
                        Width="110"
                        Height="35"
                        Margin="0,20,10,0"
                        Click="RefreshButton_Click"/>

                <Button Content="Закрыть"
                        Width="110"
                        Height="35"
                        Margin="0,20,0,0"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="LogDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  FontSize="14"
                  Background="White"/>

        <TextBlock x:Name="InfoTextBlock"
                   Grid.Row="3"
                   Text="Журнал фиксирует действия пользователей в системе."
                   FontSize="15"
                   FontWeight="Bold"
                   Foreground="#2D3748"
                   Margin="0,15,0,0"/>
    </Grid>
</Window>