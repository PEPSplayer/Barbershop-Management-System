<Window x:Class="HairSalonIS.Views.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ"
        Height="760"
        Width="820"
        MinHeight="680"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F4F6F8">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Данные заказа"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#2D3748"
                       Margin="0,0,0,20"/>

            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Администратор"
                               FontSize="14"
                               Margin="0,0,0,5"/>

                    <ComboBox x:Name="AdministratorComboBox"
                              Height="38"
                              FontSize="14"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Клиент"
                               FontSize="14"
                               Margin="0,0,0,5"/>

                    <ComboBox x:Name="ClientComboBox"
                              Height="38"
                              FontSize="14"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,0,0,15">
                <TextBlock Text="Мастер"
                           FontSize="14"
                           Margin="0,0,0,5"/>

                <ComboBox x:Name="MasterComboBox"
                          Height="38"
                          FontSize="14"/>
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Дата заказа"
                               FontSize="14"
                               Margin="0,0,0,5"/>

                    <DatePicker x:Name="OrderDatePicker"
                                Height="38"
                                FontSize="14"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Время начала"
                               FontSize="14"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="TimeFromTextBox"
                             Height="38"
                             FontSize="14"
                             Text="10:00"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Время окончания"
                               FontSize="14"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="TimeBeforeTextBox"
                             Height="38"
                             FontSize="14"
                             Text="11:00"/>
                </StackPanel>
            </Grid>

            <CheckBox x:Name="StatusCheckBox"
                      Grid.Row="4"
                      Content="Заказ выполнен"
                      FontSize="14"
                      Margin="0,0,0,15"/>

            <Grid Grid.Row="5" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="140"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Услуги заказа"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,10">

                            <ComboBox x:Name="ServiceComboBox"
                                      Width="220"
                                      Height="36"
                                      Margin="0,0,10,0"/>

                            <Button Content="Добавить"
                                    Width="100"
                                    Height="36"
                                    Click="AddServiceButton_Click"/>
                        </StackPanel>

                        <ListBox x:Name="SelectedServicesListBox"
                                 Grid.Row="2"
                                 DisplayMemberPath="Name"/>

                        <Button Grid.Row="3"
                                Content="Удалить услугу"
                                Width="130"
                                Height="34"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0"
                                Click="RemoveServiceButton_Click"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Background="White"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="140"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Материалы заказа"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,10">

                            <ComboBox x:Name="MaterialComboBox"
                                      Width="170"
                                      Height="36"
                                      Margin="0,0,10,0"/>

                            <TextBox x:Name="MaterialQuantityTextBox"
                                     Width="55"
                                     Height="36"
                                     Text="1"
                                     Margin="0,0,10,0"/>

                            <Button Content="Добавить"
                                    Width="90"
                                    Height="36"
                                    Click="AddMaterialButton_Click"/>
                        </StackPanel>

                        <ListBox x:Name="SelectedMaterialsListBox"
                                 Grid.Row="2"
                                 DisplayMemberPath="DisplayText"/>

                        <Button Grid.Row="3"
                                Content="Удалить материал"
                                Width="145"
                                Height="34"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0"
                                Click="RemoveMaterialButton_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Grid.Row="6"
                       Text="Чек формируется автоматически из стоимости выбранных услуг."
                       Foreground="#4B5563"
                       FontSize="14"
                       Margin="0,0,0,10"/>

            <StackPanel Grid.Row="9"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">

                <Button Content="Сохранить"
                        Width="120"
                        Height="38"
                        Margin="0,0,10,0"
                        Click="SaveButton_Click"/>

                <Button Content="Отмена"
                        Width="120"
                        Height="38"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>