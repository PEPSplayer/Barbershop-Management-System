<Window x:Class="HairSalonIS.Views.MaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Материал"
        Height="430"
        Width="560"
        MinHeight="390"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F4F6F8">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Данные материала"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#2D3748"
                       Margin="0,0,0,25"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="Название материала"
                           FontSize="14"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="MaterialNameTextBox"
                         Height="38"
                         FontSize="14"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,15">
                <TextBlock Text="Категория материала"
                           FontSize="14"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="MaterialCategoryTextBox"
                         Height="38"
                         FontSize="14"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,15">
                <TextBlock Text="Количество на складе"
                           FontSize="14"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="MaterialQuantityTextBox"
                         Height="38"
                         FontSize="14"/>
            </StackPanel>

            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Сохранить"
                        Width="120"
                        Height="38"
                        Margin="0,0,10,0"
                        Click="SaveButton_Click"/>

                <Button Content="Отмена"
                        Width="120"
                        Height="38"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>