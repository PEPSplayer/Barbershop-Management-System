<Window x:Class="HairSalonIS.Views.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Расписание"
        Height="650"
        Width="520"
        MinHeight="560"
        MinWidth="500"
        MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F4F6F8">

      
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Запись в расписании"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#2D3748"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Администратор"
                       FontSize="14"
                       Margin="0,0,0,5"/>

            <ComboBox x:Name="AdministratorComboBox"
                      Height="35"
                      FontSize="14"
                      VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Мастер"
                       FontSize="14"
                       Margin="0,0,0,5"/>

            <ComboBox x:Name="MasterComboBox"
                      Height="35"
                      FontSize="14"
                      VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock Text="Дата"
                       FontSize="14"
                       Margin="0,0,0,5"/>

            <DatePicker x:Name="ScheduleDatePicker"
                        Height="35"
                        FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,15">
            <TextBlock Text="Время начала, например 10:00"
                       FontSize="14"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="TimeFromTextBox"
                     Height="35"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,15">
            <TextBlock Text="Время окончания, например 11:30"
                       FontSize="14"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="TimeBeforeTextBox"
                     Height="35"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Сохранить"
                    Width="110"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="SaveButton_Click"/>

            <Button Content="Отмена"
                    Width="110"
                    Height="35"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>